map $http_authorization $api_key_valid {
    default        0;
    "Bearer ${SITE_API_KEY}"  1;
}

server {
    listen 3800;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location /health {
        proxy_pass http://127.0.0.1:3433/health;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /v1/ {
        if ($api_key_valid = 0) {
            return 401 '{"error":"Invalid or missing bearer token"}';
        }
        proxy_pass http://127.0.0.1:3433/v1/;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 500m;
    }
}
